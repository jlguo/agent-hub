// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Room - represents a conversation space (e.g., "Family")
model Room {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("family") // family, friends, colleagues
  description String?
  context     String? // Room-specific context for AI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // External chat platform mapping (e.g., Feishu group ID)
  externalChatId String? @unique

  agents      Agent[]
  messages    Message[]
  discussions Discussion[]

  // OpenClaw session tracking
  openclawSessionId String?
  sessionMaxAge     Int       @default(86400) // 24 hours in seconds
  sessionCreatedAt  DateTime?
}

// Agent - an AI persona in a room
model Agent {
  id     String @id @default(uuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  name   String
  role   String // e.g., "father", "mother", "child", "grandparent"
  avatar String? // URL or emoji

  // Personality traits (0-100)
  talkativeness Int @default(50)
  empathy       Int @default(50)
  curiosity     Int @default(50)

  // System prompt override (optional)
  systemPrompt String?

  // Status
  isActive      Boolean @default(true)
  responseDelay Int     @default(1000) // ms, for realism

  // Relationships to other agents
  relationshipsAsA Relationship[] @relation("AgentARelationships")
  relationshipsAsB Relationship[] @relation("AgentBRelationships")

  // Messages from this agent
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, name])
}

// Relationship - defines how agents relate to each other
model Relationship {
  id       String @id @default(uuid())
  agentAId String
  agentBId String
  agentA   Agent  @relation("AgentARelationships", fields: [agentAId], references: [id], onDelete: Cascade)
  agentB   Agent  @relation("AgentBRelationships", fields: [agentBId], references: [id], onDelete: Cascade)

  type     String // parent-of, child-of, spouse, sibling, friend, colleague
  strength Int     @default(50) // 0-100
  context  String? // Additional context about the relationship

  createdAt DateTime @default(now())

  @@unique([agentAId, agentBId])
}

// Message - conversation history
model Message {
  id     String @id @default(uuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  agentId String? // null if from admin user
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  role    String // "user" or "assistant"
  content String

  // Metadata
  metadata String? // JSON string for additional data

  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

// Discussion - tracks active topic discussions
model Discussion {
  id     String @id @default(uuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  topic     String
  heatScore Int    @default(50) // 0-100
  status    String @default("active") // active, cooling, ended

  // Participants (stored as JSON array of agent IDs)
  participants String? // JSON array: ["agent1", "agent2"]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  endedAt   DateTime?

  @@index([roomId, status])
}
