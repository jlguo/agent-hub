{
  "name": "agent-hub",
  "version": "0.0.2",
  "description": "Multi-agent collaboration platform for realistic group conversations.",
  "main": "server/dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint server/src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:check": "jest --coverage --coverageThreshold='{\"global\":{\"branches\":80,\"functions\":80,\"lines\":80,\"statements\":80}}'",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:validate-rules": "tsx scripts/validate-tests.ts",
    "test:ci": "npm run test -- --ci --reporters=default --reporters=jest-junit",
    "prepare": "husky install"
  },
  "keywords": [
    "agent",
    "ai",
    "conversation",
    "multi-agent"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@prisma/client": "^5.10.0",
    "@types/dotenv": "^6.1.1",
    "axios": "^1.14.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@faker-js/faker": "10.4.0",
    "@playwright/test": "^1.58.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.37",
    "@types/supertest": "7.2.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "husky": "^9.1.7",
    "jest": "30.3.0",
    "jest-junit": "^16.0.0",
    "playwright": "^1.58.2",
    "prisma": "^5.10.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
