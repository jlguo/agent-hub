{
  "name": "agent-hub",
  "version": "0.0.2",
  "description": "Multi-agent collaboration platform for realistic group conversations.",
  "main": "server/dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint server/src --ext .ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "jest --config=server/jest.config.js",
    "test:unit": "jest --config=server/jest.config.js",
    "test:watch": "jest --config=server/jest.config.js --watch",
    "test:coverage": "jest --config=server/jest.config.js --coverage",
    "test:coverage:check": "npm run test:coverage && tsx scripts/check-coverage.ts",
    "test:pre-commit": "jest --config=server/jest.config.js --findRelatedTests --bail",
    "test:integration": "jest --config=server/jest.config.js --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:validate-rules": "tsx scripts/validate-tests.ts",
    "test:ci": "npm run test -- --ci --reporters=default --reporters=jest-junit",
    "prepare": "husky",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "docker:clean": "docker-compose down -v",
    "k8s:dev": "helm upgrade --install agent-hub-dev ./k8s/helm/agent-hub --namespace agent-hub-dev --create-namespace --values k8s/helm/agent-hub/values-dev.yaml",
    "k8s:prod": "helm upgrade --install agent-hub-prod ./k8s/helm/agent-hub --namespace agent-hub-prod --create-namespace",
    "k8s:uninstall": "helm uninstall agent-hub-dev agent-hub-prod 2>/dev/null || true"
  },
  "keywords": [
    "agent",
    "ai",
    "conversation",
    "multi-agent"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@types/dotenv": "^6.1.1",
    "axios": "^1.14.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "socket.io": "^4.6.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@faker-js/faker": "10.4.0",
    "@playwright/test": "^1.58.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.37",
    "@types/supertest": "7.2.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "30.3.0",
    "jest-html-reporter": "^4.4.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "prisma": "^6.19.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
