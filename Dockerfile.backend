# Multi-stage build for Agent Hub Backend
FROM node:20-alpine AS base

# Install OpenSSL 3 for Prisma compatibility (Alpine 3.18+) + wget for health checks
RUN apk add --no-cache openssl3 libssl3 libc6-compat wget

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Stage 2: Build stage
FROM base AS builder

# Use npm install instead of ci (more resilient to network issues)
RUN npm install

# Copy server source
COPY server/ ./server/
COPY prisma/ ./prisma/

# Generate Prisma client
RUN npx prisma generate

# Stage 3: Production image (uses tsx watch for development)
FROM node:20-alpine AS production

# Install su-exec for privilege dropping
RUN apk add --no-cache su-exec

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nodeuser

# Copy ALL dependencies (including dev for tsx)
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/server ./server
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/package.json ./package.json

# Create prisma directory with correct permissions for volume mount
# This ensures the directory is writable even when Docker creates a volume
RUN mkdir -p /app/prisma && \
    chmod 777 /app/prisma && \
    chown -R nodeuser:nodejs /app

USER nodeuser
WORKDIR /app

# Expose port
EXPOSE 4000

# Health check (use 127.0.0.1 to force IPv4)
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:4000/health || exit 1

# Start server with tsx watch (development mode)
CMD ["npm", "run", "dev"]
