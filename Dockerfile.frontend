# Multi-stage build for Agent Hub Frontend
FROM node:20-alpine AS base

RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy root package files
COPY package.json package-lock.json ./

# Copy client package files
COPY client/package.json client/package-lock.json ./client/

# Stage 2: Build stage (skip build, use dev mode)
FROM base AS builder

# Install all dependencies
WORKDIR /app
RUN npm install

WORKDIR /app/client
RUN npm install

# Copy client source
COPY client/ ./client/

# Stage 3: Production image (uses dev mode)
FROM base AS production

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nodeuser

# Copy ALL dependencies (including dev for next dev)
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/client/node_modules ./client/node_modules
COPY --from=builder /app/client ./client
COPY --from=builder /app/package.json ./package.json

# Create app directory and set ownership
RUN mkdir -p /app && chown -R nodeuser:nodejs /app

USER nodeuser
WORKDIR /app/client

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000 || exit 1

# Start Next.js dev server
CMD ["npm", "run", "dev"]
