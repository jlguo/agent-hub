# Remote Mode Environment Configuration
# Copy this to .env and fill in your values

# ============================================
# OpenClaw Remote Access
# ============================================
OPENCLAW_MODE=remote
OPENCLAW_VERIFICATION_TOKEN=your-openclaw-token-here

# SSH Tunnel Configuration
SSH_HOST=your-remote-host-ip-or-domain
SSH_USER=your-ssh-username
SSH_PORT=22

# ============================================
# Feishu Integration
# ============================================
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_CHAT_ID=oc_xxx
FEISHU_VERIFY_TOKEN=your-feishu-verify-token

# ============================================
# Security
# ============================================
JWT_SECRET=generate-a-secure-secret-min-32-chars
ENCRYPTION_KEY=generate-a-64-hex-char-key

# ============================================
# Optional: Logging
# ============================================
LOG_LEVEL=info
