# Agent Hub Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=file:./prisma/dev.db

# ============================================
# Server Configuration
# ============================================
PORT=4000
NODE_ENV=development

# ============================================
# OpenClaw Configuration (Remote Mode)
# ============================================
OPENCLAW_MODE=remote
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here
OPENCLAW_VERIFICATION_TOKEN=your-verification-token-here
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=1

# SSH Tunnel for Remote OpenClaw Gateway
SSH_HOST=localhost
SSH_USER=root
SSH_PORT=22
SSH_KEY_PATH=~/.ssh/agent-hub/id_ed25519

# ============================================
# Feishu/Lark Configuration
# ============================================
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_CHAT_ID=oc_xxx
FEISHU_VERIFY_TOKEN=your-verify-token-here

# ============================================
# Security Configuration
# ============================================
JWT_SECRET=your-jwt-secret-min-32-chars
ENCRYPTION_KEY=your-64-char-hex-key-here
API_KEY=your-internal-api-key-here

# ============================================
# Heat System Configuration (Optional)
# ============================================
HEAT_BASE_INCREMENT=25
HEAT_USER_MULTIPLIER=2.0
HEAT_AGENT_MULTIPLIER=0.8
HEAT_DECAY_RATE=0.12

# ============================================
# Monitoring (Optional)
# ============================================
SENTRY_DSN=your-sentry-dsn-here
