# Server Configuration
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL="file:./prisma/dev.db"

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# OpenClaw Integration (CLI + Webhook)
# =========================================
# Webhook: Receives inbound messages from OpenClaw Gateway
# Configure in OpenClaw config:
#   channels.feishu.connectionMode: "webhook"
#   channels.feishu.webhookPath: "/api/webhooks/openclaw"
#   channels.feishu.webhookHost: "localhost"
#   channels.feishu.webhookPort: 4000
OPENCLAW_VERIFICATION_TOKEN=your-secret-token-change-this

# CLI: Sends outbound messages to OpenClaw Gateway
# Command format: openclaw agent --message "text" --agent "name" --session "id"
# No additional config needed - uses OpenClaw CLI directly

# Session Configuration (for Session Guardian)
SESSION_MAX_AGE=3600000
SESSION_CHECK_INTERVAL=30000
